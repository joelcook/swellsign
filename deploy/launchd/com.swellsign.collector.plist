<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the collector running on a Mac between now and the Raspberry Pi.

  Install, substituting the two placeholders for your own paths. They are
  placeholders rather than real values so this file does not publish one
  machine's username and directory layout to everyone who clones the repo:

    sed -e "s|__PROJECT_DIR__|$PWD|g" \
        -e "s|__PYTHON__|$(command -v python3)|g" \
        deploy/launchd/com.swellsign.collector.plist \
        > ~/Library/LaunchAgents/com.swellsign.collector.plist
    launchctl load ~/Library/LaunchAgents/com.swellsign.collector.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.swellsign.collector.plist

  Both must be absolute: launchd runs with a minimal environment and will not
  resolve anything from a shell PATH.

  The collector takes an exclusive lock on the database, so a second copy exits
  rather than double-polling. Stop any ad-hoc `swellsign collector` before
  loading this, or KeepAlive will restart it against a held lock.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swellsign.collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>swellsign</string>
        <string>collector</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__PROJECT_DIR__/src</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Back off before restarting so a provider outage does not become a
         tight crash loop against NOAA. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/collector.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/collector.log</string>

    <!-- Background priority: this is an appliance, not something the user is
         waiting on. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
